{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p4u-spatial.example/schema/scan.schema.json",
  "title": "P4U Spatial Scan Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "scanId",
    "device",
    "mode",
    "createdAt",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "scanId": {
      "type": "string",
      "format": "uuid"
    },
    "device": {
      "type": "object",
      "required": [
        "deviceId",
        "platform",
        "model"
      ],
      "properties": {
        "deviceId": {
          "type": "string"
        },
        "platform": {
          "type": "string",
          "examples": [
            "pico",
            "meta"
          ]
        },
        "model": {
          "type": "string",
          "examples": [
            "pico-4-ultra",
            "quest-3"
          ]
        },
        "runtime": {
          "type": "string"
        },
        "appVersion": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "mode": {
      "enum": [
        "indoor",
        "site",
        "registration",
        "drift-test"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "coordinateFrame": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "mediaType": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
