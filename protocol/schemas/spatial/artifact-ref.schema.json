{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spatial/artifact-ref.schema.json",
  "type": "object",
  "required": ["sourceId", "artifactId"],
  "properties": {
    "sourceId": {
      "$ref": "../core/definitions.schema.json#/$defs/uuid"
    },
    "artifactId": {
      "$ref": "../core/definitions.schema.json#/$defs/opaqueId"
    },
    "sha256": {
      "$ref": "../core/definitions.schema.json#/$defs/sha256"
    },
    "size": {
      "type": "integer",
      "minimum": 0
    },
    "mediaType": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
