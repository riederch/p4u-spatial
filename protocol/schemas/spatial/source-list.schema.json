{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spatial/source-list.schema.json",
  "type": "object",
  "required": ["sources"],
  "properties": {
    "sources": {
      "type": "array",
      "items": {"$ref": "source.schema.json"}
    },
    "links": {
      "type": "array",
      "items": {"$ref": "../core/link.schema.json"}
    }
  },
  "additionalProperties": true
}
