{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spatial/artifact-upload-request.schema.json",
  "type": "object",
  "required": ["uploadId", "sha256", "size", "mediaType"],
  "properties": {
    "uploadId": {
      "$ref": "../core/definitions.schema.json#/$defs/uuid"
    },
    "sha256": {
      "$ref": "../core/definitions.schema.json#/$defs/sha256"
    },
    "size": {
      "type": "integer",
      "minimum": 0
    },
    "mediaType": {
      "type": "string",
      "minLength": 1
    },
    "filename": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
