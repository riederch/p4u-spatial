{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p4u-spatial.example/schema/spatial/transform.schema.json",
  "title": "Spatial Frame Transform",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "sourceFrame",
    "targetFrame",
    "type",
    "createdAt",
    "provenance"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "id": {"type": "string"},
    "sourceFrame": {"type": "string"},
    "targetFrame": {"type": "string"},
    "type": {
      "enum": ["rigid-3d", "similarity-3d", "crs-operation"]
    },
    "translation": {
      "type": "array",
      "prefixItems": [
        {"type": "number"},
        {"type": "number"},
        {"type": "number"}
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "rotation": {
      "description": "Quaternion [x,y,z,w]",
      "type": "array",
      "prefixItems": [
        {"type": "number"},
        {"type": "number"},
        {"type": "number"},
        {"type": "number"}
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "scale": {"type": "number", "exclusiveMinimum": 0},
    "operation": {"type": "string"},
    "controlPoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "target"],
        "properties": {
          "id": {"type": "string"},
          "source": {
            "type": "array",
            "items": {"type": "number"},
            "minItems": 2,
            "maxItems": 3
          },
          "target": {
            "type": "array",
            "items": {"type": "number"},
            "minItems": 2,
            "maxItems": 3
          },
          "residualMetres": {"type": "number", "minimum": 0}
        },
        "additionalProperties": true
      }
    },
    "quality": {
      "type": "object",
      "properties": {
        "rmsErrorMetres": {"type": "number", "minimum": 0},
        "maxErrorMetres": {"type": "number", "minimum": 0},
        "controlPointCount": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "createdAt": {
      "$ref": "../core/definitions.schema.json#/$defs/timestamp"
    },
    "provenance": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"enum": ["rigid-3d", "similarity-3d"]}}},
      "then": {"required": ["translation", "rotation"]}
    },
    {
      "if": {"properties": {"type": {"const": "similarity-3d"}}},
      "then": {"required": ["scale"]}
    },
    {
      "if": {"properties": {"type": {"const": "crs-operation"}}},
      "then": {"required": ["operation"]}
    }
  ],
  "additionalProperties": true
}
