{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spatial/source.schema.json",
  "type": "object",
  "required": [
    "sourceId",
    "title",
    "route",
    "access",
    "delivery",
    "capabilities",
    "links"
  ],
  "properties": {
    "sourceId": {
      "$ref": "../core/definitions.schema.json#/$defs/uuid"
    },
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "sourceRevision": {
      "$ref": "../core/definitions.schema.json#/$defs/opaqueRevision"
    },
    "route": {
      "$ref": "route.schema.json"
    },
    "access": {
      "$ref": "access-view.schema.json"
    },
    "delivery": {
      "$ref": "delivery.schema.json"
    },
    "capabilities": {
      "$ref": "../core/definitions.schema.json#/$defs/capabilitySet"
    },
    "writePolicy": {
      "$ref": "write-policy.schema.json"
    },
    "links": {
      "type": "array",
      "items": {"$ref": "../core/link.schema.json"}
    }
  },
  "additionalProperties": true
}
