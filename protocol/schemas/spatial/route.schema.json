{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spatial/route.schema.json",
  "type": "object",
  "required": ["routeId", "kind"],
  "properties": {
    "routeId": {
      "$ref": "../core/definitions.schema.json#/$defs/opaqueId"
    },
    "kind": {
      "enum": ["direct", "federated"]
    },
    "upstreamInstanceId": {
      "$ref": "../core/definitions.schema.json#/$defs/uuid"
    },
    "accessMode": {
      "enum": ["anonymous", "service", "delegated-user"]
    },
    "delegation": {
      "type": "object",
      "required": ["method"],
      "properties": {
        "method": {
          "enum": ["authorization-code-pkce", "token-exchange"]
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "federated"}}},
      "then": {
        "required": ["upstreamInstanceId", "accessMode"]
      }
    },
    {
      "if": {"properties": {"accessMode": {"const": "delegated-user"}}},
      "then": {
        "required": ["delegation"]
      }
    },
    {
      "if": {
        "required": ["delegation"],
        "properties": {
          "accessMode": {"not": {"const": "delegated-user"}}
        }
      },
      "then": false
    }
  ],
  "additionalProperties": true
}
