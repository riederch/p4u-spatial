{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "app-sync/conflict.schema.json",
  "type": "object",
  "required": ["type", "currentRevision"],
  "properties": {
    "type": {
      "enum": ["revision-mismatch", "object-exists", "object-missing"]
    },
    "baseRevision": {
      "$ref": "../core/definitions.schema.json#/$defs/opaqueRevision"
    },
    "currentRevision": {
      "$ref": "../core/definitions.schema.json#/$defs/opaqueRevision"
    },
    "currentObject": {
      "$ref": "workspace-object.schema.json"
    }
  },
  "additionalProperties": true
}
