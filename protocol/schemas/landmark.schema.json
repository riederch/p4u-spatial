{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p4u-spatial.example/schema/landmark.schema.json",
  "title": "P4U Spatial Landmark",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "frame",
    "position",
    "stability"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string"
    },
    "frame": {
      "type": "string"
    },
    "position": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "stability": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "recognition": {
      "enum": [
        "manual",
        "natural-visual",
        "artificial-marker",
        "persistent-anchor"
      ]
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "additionalProperties": true
}
