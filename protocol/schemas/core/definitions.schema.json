{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "core/definitions.schema.json",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "opaqueRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "scope": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "capabilitySet": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      },
      "uniqueItems": true
    },
    "contract": {
      "type": "object",
      "required": ["version", "href"],
      "properties": {
        "version": {"type": "string"},
        "href": {"type": "string", "format": "uri"}
      },
      "additionalProperties": true
    }
  }
}
