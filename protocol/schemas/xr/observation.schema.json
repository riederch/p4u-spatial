{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p4u-spatial.example/schema/xr/observation.schema.json",
  "title": "XR Observation",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "deviceId",
    "createdAt",
    "kind"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "id": {
      "$ref": "../core/definitions.schema.json#/$defs/opaqueId"
    },
    "deviceId": {
      "$ref": "../core/definitions.schema.json#/$defs/uuid"
    },
    "createdAt": {
      "$ref": "../core/definitions.schema.json#/$defs/timestamp"
    },
    "kind": {
      "enum": [
        "manual-confirmation",
        "manual-correction",
        "asset-capture",
        "landmark-capture",
        "task-answer"
      ]
    },
    "subject": {
      "$ref": "../spatial/object-ref.schema.json"
    },
    "targetId": {
      "$ref": "../core/definitions.schema.json#/$defs/opaqueId"
    },
    "payload": {"type": "object"}
  },
  "additionalProperties": true
}
