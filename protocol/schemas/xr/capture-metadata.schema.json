{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p4u-spatial.example/schema/xr/capture-metadata.schema.json",
  "title": "XR Capture Metadata",
  "type": "object",
  "required": [
    "purpose",
    "precision"
  ],
  "properties": {
    "purpose": {
      "enum": [
        "room-survey",
        "building-survey",
        "asset-registration",
        "registration",
        "drift-test",
        "free-capture"
      ]
    },
    "precision": {
      "enum": [
        "relative-only",
        "local-metric",
        "registered"
      ]
    },
    "subject": {
      "type": "object",
      "required": [
        "sourceId",
        "objectId"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "objectId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "runtimeCapabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "registration": {
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "enum": [
            "anchor",
            "landmarks",
            "manual",
            "external"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "sourceId",
        "method"
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
