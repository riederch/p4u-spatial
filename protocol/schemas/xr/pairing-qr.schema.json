{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p4u-spatial.example/schema/xr/pairing-qr.schema.json",
  "title": "XR Pairing QR Payload",
  "type": "object",
  "required": ["version", "bridge", "pairingId", "secret", "expiresAt"],
  "properties": {
    "version": {"const": 1},
    "bridge": {"type": "string", "format": "uri"},
    "pairingId": {
      "$ref": "../core/definitions.schema.json#/$defs/uuid"
    },
    "secret": {"type": "string", "minLength": 22},
    "expiresAt": {
      "$ref": "../core/definitions.schema.json#/$defs/timestamp"
    }
  },
  "additionalProperties": false
}
