<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission
        android:name="at.p4u.spatial.scanner.permission.SECUREMR_RESULT"
        android:protectionLevel="signature" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="com.picovr.permission.HAND_TRACKING" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.vr.headtracking" android:required="true" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".MainApplication"
        android:allowBackup="false"
        android:label="P4U Spatial Scanner"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <meta-data
            android:name="pvr.app.secure_mr"
            android:value="1" />
        <meta-data
            android:name="pvr.app.type"
            android:value="vr" />
        <meta-data
            android:name="enable_mr_safeguard"
            android:value="1" />

        <!-- PICO ControllersAndHands interaction mode.
             Keep both markers: the launcher/runtime may select either input source. -->
        <meta-data
            android:name="handtracking"
            android:value="1" />
        <meta-data
            android:name="controller"
            android:value="1" />
        <meta-data
            android:name="Hand_Tracking_HighFrequency"
            android:value="0" />

        <activity
            android:name=".MainActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density|uiMode|keyboardHidden|navigation|keyboard"
            android:excludeFromRecents="false"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">

            <meta-data
                android:name="android.app.lib_name"
                android:value="securemrprobe" />
            <meta-data
                android:name="com.oculus.vr.focusaware"
                android:value="true" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="com.oculus.intent.category.VR" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>
    </application>
</manifest>
